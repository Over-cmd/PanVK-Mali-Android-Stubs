[binaries]
c = ['ccache', 'NDKDIR/bin/aarch64-linux-android30-clang']
cpp = ['ccache', 'NDKDIR/bin/aarch64-linux-android30-clang++']
ar = 'NDKDIR/bin/llvm-ar'
strip = 'NDKDIR/bin/llvm-strip'
rust = ['rustc', '--target', 'aarch64-linux-android']

[properties]
c_args = ['-DANDROID']
cpp_args = ['-DANDROID', '-fno-exceptions', '-static-libstdc++']
cpp_link_args = ['-static-libstdc++']

[host_machine]
system = 'android'
cpu_family = 'aarch64'
cpu = 'armv8-a'
endian = 'little'
