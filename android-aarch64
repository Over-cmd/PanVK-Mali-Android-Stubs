[binaries]
c = ['ccache', 'NDKDIR/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android30-clang']
cpp = ['ccache', 'NDKDIR/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android30-clang++']
ar = 'NDKDIR/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar'
strip = 'NDKDIR/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-strip'
rust = ['rustc', '--target', 'aarch64-linux-android']

[properties]
c_args = ['-DANDROID', '--sysroot=NDKDIR/toolchains/llvm/prebuilt/linux-x86_64/sysroot']
cpp_args = ['-DANDROID', '--sysroot=NDKDIR/toolchains/llvm/prebuilt/linux-x86_64/sysroot', '-fno-exceptions', '-static-libstdc++']
cpp_link_args = ['--sysroot=NDKDIR/toolchains/llvm/prebuilt/linux-x86_64/sysroot', '-static-libstdc++']

[host_machine]
system = 'android'
cpu_family = 'aarch64'
cpu = 'armv8-a'
endian = 'little'
