# =========================================================================
# STAGE 1: Entorno de Compilación Cruzada con funnymdzz (Mali kbase)
# =========================================================================
FROM ubuntu:24.04 AS builder
WORKDIR /root

# Evitar diálogos interactivos durante la instalación de paquetes
ENV DEBIAN_FRONTEND=noninteractive

# Instalar dependencias esenciales completas del sistema host
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    meson \
    ninja-build \
    python3 \
    python3-pip \
    python3-mako \
    git \
    bison \
    flex \
    pkg-config \
    libdrm-dev \
    libxshmfence-dev \
    glslang-tools \
    rustup \
    && rm -rf /var/lib/apt/lists/*

# Instalar cbindgen de forma instantánea vía Pip para ahorrar tiempo de CPU
RUN pip3 install --break-system-packages cbindgen || pip3 install cbindgen || true

# Configurar el compilador de Rust oficial e inyectar de forma obligatoria el target de Android ARM64
RUN rustup default stable \
    && rustup target add aarch64-linux-android

# Exportar las variables de entorno de Rust de forma global y permanente en Docker
ENV PATH="/root/.cargo/bin:${PATH}"

# Forzar el enlace simbólico de glslang para que Meson lo localice sin problemas
RUN ln -s /usr/bin/glslangValidator /usr/bin/glslang_validator || true

# Recibimos las fuentes de Mesa, el Android NDK intacto y los archivos locales desde el flujo YAML
COPY ./mesa /root/mesa
COPY ./android-ndk /root/android-ndk
COPY ./extensions.patch /root/extensions.patch
COPY ./android_stub.patch /root/android_stub.patch
COPY ./android-aarch64 /root/android-aarch64

# CONFIGURACIÓN DE ENTORNO EN CALIENTE PARA CLANG Y RUST:
ENV PATH="/root/android-ndk/toolchains/llvm/prebuilt/linux-x86_64/bin:${PATH}"
ENV CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER="/root/android-ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android30-clang"
ENV RUSTFLAGS="-C linker=/root/android-ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android30-clang"

# Aplicar los parches locales e inyectar la ruta física del NDK en el cross-file
RUN cd /root/mesa \
    && patch -p1 < /root/extensions.patch || true \
    && patch -p1 < /root/android_stub.patch || true \
    && sed -i "s|NDKDIR|/root/android-ndk|g" /root/android-aarch64

# =========================================================================
# PASO MAESTRO 1: Compilar de forma Nativa las herramientas de compilación de Shaders (mesa-clc)
# =========================================================================
RUN cd /root/mesa \
    && meson setup build-native \
       -Dgallium-drivers=none \
       -Dvulkan-drivers=none \
       -Dplatforms=x11 \
       -Dbuild-aco-tests=false \
    && ninja -C build-native src/compiler/clc/mesa_clc

# =========================================================================
# PASO MAESTRO 2: Ejecutar la Compilación Cruzada real para Android kbase
# Apuntamos a la ruta de mesa_clc nativa para que valide la sanidad de inmediato
# =========================================================================
RUN cd /root/mesa \
    && meson setup build-android \
       --cross-file /root/android-aarch64 \
       -Dbuildtype=release \
       -Dshared-glapi=false \
       -Dgallium-drivers=none \
       -Dvulkan-drivers=panfrost \
       -Dpanfrost-kmds=kbase \
       -Dpanfrost-rust=true \
       -Dplatforms=android \
       -Dglx=disabled \
       -Degl=disabled \
       -Dgbm=disabled \
       -Dgles1=disabled \
       -Dgles2=disabled \
       -Dmesa-clc=/root/mesa/build-native/src/compiler/clc/mesa_clc \
    && ninja -C build-android

# =========================================================================
# STAGE 2: Conservación del Archivo Real Monolítico para la Extracción
# =========================================================================
FROM ubuntu:24.04 AS final
WORKDIR /dist

# Conservamos el binario real compilado de Mali con su nombre original
COPY --from=builder /root/mesa/build-android/src/panfrost/vulkan/libvulkan_panfrost.so ./libvulkan_panfrost.so
