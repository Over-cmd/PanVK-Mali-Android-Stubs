# ==========================================
# STAGE 1: Entorno de configuración con NDK y Rust
# ==========================================
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_NDK_HOME=/opt/android-ndk

# Instalar absolutamente todas las dependencias requeridas por Mesa 26.2
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    python3-pip \
    python3-setuptools \
    ninja-build \
    bison \
    flex \
    m4 \
    pkg-config \
    git \
    glslang-tools \
    rustc \
    cargo \
    clang \
    libclang-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install meson mako
RUN cargo install --root /usr/local bindgen-cli || true

# Recibir el NDK pre-descargado desde el host de GitHub Actions
ARG NDK_PATH_HOST
COPY ${NDK_PATH_HOST} ${ANDROID_NDK_HOME}

WORKDIR /workspace
COPY . .

# ==========================================
# STAGE 2: Compilación Cruzada de 32 Bits (armeabi-v7a)
# ==========================================
RUN meson setup build-32 \
    --cross-file android-32.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dandroid-stub=true \
    -Dgallium-drivers=swrast \
    -Dvulkan-drivers=panfrost \
    -Dmesa-clc=auto \
    && ninja -C build-32/ src/panfrost/vulkan/libvulkan_panfrost.so

# ==========================================
# STAGE 3: Compilación Cruzada de 64 Bits (arm64-v8a)
# ==========================================
RUN meson setup build-64 \
    --cross-file android-64.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dandroid-stub=true \
    -Dgallium-drivers=swrast \
    -Dvulkan-drivers=panfrost \
    -Dmesa-clc=auto \
    && ninja -C build-64/ src/panfrost/vulkan/libvulkan_panfrost.so

# ==========================================
# STAGE 4: Empaquetado oficial idéntico a la Release v1.0-alpha
# ==========================================
FROM alpine:latest AS final
WORKDIR /dist

# Crear estructura limpia para los artefactos de salida
RUN mkdir -p panvk-release/lib/armeabi-v7a \
    && mkdir -p panvk-release/lib/arm64-v8a

# Copiar y renombrar los archivos binarios resultantes tal como lo exige el manifiesto de la release
COPY --from=builder /workspace/build-32/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-release/lib/armeabi-v7a/libvulkan_freedreno.so
COPY --from=builder /workspace/build-64/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-release/lib/arm64-v8a/libvulkan_freedreno.so

# Si tu compilación de Gallium también generó libGL y libglapi, los añadimos. Por ahora, aseguramos el Vulkan Core:
RUN echo '{\
  "schemaVersion": 1,\
  "name": "Mesa PanVK Driver for Mali (Bifrost Forced)",\
  "description": "Custom PanVK Vulkan driver for MediaTek Bifrost architecture using Android UMD stubs.",\
  "author": "Mesa Community / Over-cmd",\
  "packageVersion": "26.2",\
  "vendor": "Mesa",\
  "driverVersion": "1",\
  "libraryName": "libvulkan_freedreno.so"\
}' > ./panvk-release/meta.json

# Empaquetar todo en el archivo ZIP final estructurado
RUN apk add --no-cache zip \
    && cd panvk-release \
    && zip -r ../panvk-mali-bifrost-driver.zip ./*

CMD ["cat", "panvk-mali-bifrost-driver.zip"]
