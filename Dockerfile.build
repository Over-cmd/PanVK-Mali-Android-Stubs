# ==========================================
# STAGE 1: Generación del Paquete Forzado para Adrenotools
# ==========================================
FROM alpine:latest AS final
WORKDIR /dist

# Instalar zip para el empaquetado final
RUN apk add --no-cache zip

# Crear la estructura de carpetas obligatoria que exige el validador de Adrenotools
RUN mkdir -p package/lib/armeabi-v7a \
    && mkdir -p package/lib/arm64-v8a

# Copiamos las librerías reales pesadas dentro de las carpetas de arquitectura
COPY panvk-release/libvulkan_freedreno.so ./package/lib/armeabi-v7a/libvulkan_freedreno.so
COPY panvk-release/libvulkan_freedreno.so ./package/lib/arm64-v8a/libvulkan_freedreno.so
COPY panvk-release/libGL.so.1 ./package/lib/armeabi-v7a/libGL.so.1
COPY panvk-release/libGL.so.1 ./package/lib/arm64-v8a/libGL.so.1
COPY panvk-release/libglapi.so.0 ./package/lib/armeabi-v7a/libglapi.so.0
COPY panvk-release/libglapi.so.0 ./package/lib/arm64-v8a/libglapi.so.0

# BYPASS: Escribimos el manifiesto simulando ser un driver Turnip oficial para Snapdragon.
# Esto engaña al validador de Adrenotools, obligándolo a aceptar el paquete en tu tablet.
RUN echo '{\
  "schemaVersion": 1,\
  "name": "Turnip Driver for Adreno (Mesa PanVK Mali Forced)",\
  "description": "Bypass driver forced for MediaTek Bifrost architecture running natively on Android 11 via Adrenotools loader.",\
  "author": "Mesa Community / Qualcomm Open Source",\
  "packageVersion": "24.1.0-devel",\
  "vendor": "Qualcomm",\
  "driverVersion": "512.0",\
  "libraryName": "libvulkan_freedreno.so"\
}' > ./package/meta.json

# Duplicamos la firma como manifest.json para cubrir todas las versiones de la app
RUN cp ./package/meta.json ./package/manifest.json

# Entramos a la carpeta y comprimimos los archivos sueltos directamente en la raíz del ZIP
RUN cd package && zip -r ../panvk-mali-bifrost-driver.zip ./*

CMD ["cat", "panvk-mali-bifrost-driver.zip"]
