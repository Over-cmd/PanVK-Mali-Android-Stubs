# ==============================================================================
# STAGE 1: Entorno de Compilación Nativo del Host con LLVM y Rust (Bypass de clc)
# ==============================================================================
FROM ubuntu:24.04 AS host-compiler

ENV DEBIAN_FRONTEND=noninteractive

# Instala todas las dependencias críticas exigidas por Mesa moderno y funnymdzz
RUN apt-get update && apt-get install -y \
    build-essential \
    meson \
    ninja-build \
    pkg-config \
    python3-mako \
    python3-ply \
    python3-yaml \
    gettext \
    flex \
    bison \
    glslang-tools \
    git \
    curl \
    # 🟢 DEPENDENCIAS CRÍTICAS DE LLVM REQUERIDAS POR MESA_CLC
    llvm-dev \
    libclang-dev \
    clang \
    # 🟢 EL COMPONENTE FALTANTE DEFINITIVO: Rust nativo del host para que clc no explote
    rustc \
    cargo \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /root

# Copiamos la subcarpeta de las fuentes de Mesa clonada dinámicamente por tu Workflow
COPY mesa /root/mesa

# 🟢 PASO MAESTRO 1: Compilamos la herramienta nativa clc teniendo todo el pool de Rust y LLVM activo
RUN cd /root/mesa \
    && meson setup build-native \
        -Dgallium-drivers=none \
        -Dvulkan-drivers=none \
        -Dglx=disabled \
        -Degl=disabled \
        -Dgbm=disabled \
        -Dbuild-compile-tools=true \
    && ninja -C build-native src/compiler/clc/mesa_clc

# ==============================================================================
# STAGE 2: Compilación Cruzada para Android ARM64 (Silicio de Panfrost)
# ==============================================================================
FROM ubuntu:24.04 AS android-cross-compiler

ENV DEBIAN_FRONTEND=noninteractive

# Instala las herramientas de empaquetado y python para el target cruzado
RUN apt-get update && apt-get install -y \
    build-essential \
    meson \
    ninja-build \
    pkg-config \
    python3-mako \
    python3-ply \
    python3-yaml \
    gettext \
    flex \
    bison \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /root

# Traemos tanto las fuentes de Mesa como la herramienta mesa_clc ya compilada del Stage 1
COPY --from=host-compiler /root/mesa /root/mesa
COPY android-ndk /root/android-ndk
COPY android-aarch64 /root/android-aarch64

# Configuramos las variables de entorno para que el compilador de Rust cruzado localice el NDK
ENV ANDROID_NDK_HOME=/root/android-ndk
ENV PATH=$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin:$PATH

# 🟢 PASO MAESTRO 2: Ejecutamos la compilación cruzada pasándole la herramienta clc nativa del Stage 1
RUN cd /root/mesa \
    && meson setup build-android \
        --cross-file /root/android-aarch64 \
        -Dplatforms=android \
        -Dplatform-sdk-version=30 \
        -Dgallium-drivers=panfrost \
        -Dvulkan-drivers=panfrost,wrapper \
        -Dpanfrost-rust=true \
        -Dpanfrost-kmds=kbase \
        -Dbuild-compile-tools=false \
        -Dexternal-mesa-clc=/root/mesa/build-native/src/compiler/clc/mesa_clc \
        -Dcpp_rtti=false \
        -Dgbm=disabled \
        -Dopengl=false \
        -Dllvm=disabled \
        -Dshared-llvm=disabled \
        -Degl=enabled \
        -Dglx=disabled \
    && ninja -C build-android src/panfrost/vulkan/libvulkan_panfrost.so

# Exportamos el binario final unificado de 59MB hacia la carpeta raíz de extracción de tu Workflow
RUN mkdir -p /dist \
    && cp -fv /root/mesa/build-android/src/panfrost/vulkan/libvulkan_panfrost.so /dist/libvulkan_panfrost.so
