# =========================================================================
# STAGE 1: Entorno de Compilación y Generación de Herramientas del Host
# =========================================================================
FROM ubuntu:24.04 AS builder
WORKDIR /root
ENV DEBIAN_FRONTEND=noninteractive

# 1. Instalar dependencias necesarias (Incluyendo LLVM 18 nativo para el Host)
RUN apt-get update && apt-get install -y \
    curl build-essential meson ninja-build python3 python3-pip python3-mako git \
    bison flex pkg-config libdrm-dev libxshmfence-dev glslang-tools \
    rustup llvm-18-dev libclang-18-dev libelf-dev spirv-tools gettext \
    && rm -rf /var/lib/apt/lists/*

# 2. Configurar Rust y target móvil
RUN rustup default stable && rustup target add aarch64-linux-android
RUN ln -s /usr/bin/glslangValidator /usr/bin/glslang_validator || true

# 3. Copiar fuentes y aplicar parches
COPY ./mesa /root/mesa
COPY ./android-ndk /root/android-ndk
COPY ./extensions.patch /root/extensions.patch
COPY ./android_stub.patch /root/android_stub.patch
COPY ./android-aarch64 /root/android-aarch64

RUN cd /root/mesa \
    && patch -p1 < /root/extensions.patch || true \
    && patch -p1 < /root/android_stub.patch || true \
    && sed -i "s|NDKDIR|/root/android-ndk|g" /root/android-aarch64

# 4. FASE 1: Generación de Host Tools nativas (x86_64) - CORE MALI REPARADO
# Purgamos de raíz los parámetros inexistentes de Turnip que hacían colapsar a Meson.
# Dejamos únicamente mesa-clc activo con LLVM para fabricar el compilador nativo del Host.
RUN cd /root/mesa \
    && meson setup build-host \
       -Dplatforms= \
       -Dgallium-drivers=none \
       -Dvulkan-drivers=none \
       -Dllvm=enabled \
       -Dmesa-clc=enabled \
    && ninja -C build-host src/compiler/clc/mesa_clc

# 5. Configurar PATH y variables para compilación cruzada móviles
ENV PATH="/root/mesa/build-host/src/compiler/clc:${PATH}"
ENV NDK_PATH="/root/android-ndk/toolchains/llvm/prebuilt/linux-x86_64/bin"
ENV PATH="${NDK_PATH}:${PATH}"
ENV CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER="${NDK_PATH}/aarch64-linux-android30-clang"
ENV RUSTFLAGS="-C linker=${CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER}"

# 6. FASE 2: Compilación Cruzada para Android ARM64
RUN cd /root/mesa \
    && meson setup build-android --cross-file /root/android-aarch64 \
       -Dbuildtype=release \
       -Dshared-glapi=false \
       -Dplatforms=android,x11 \
       -Dandroid-stub=true \
       -Dplatform-sdk-version=30 \
       -Dglx=disabled \
       -Dgbm=disabled \
       -Degl=disabled \
       -Dopengl=false \
       -Dgallium-drivers=none \
       -Dmesa-clc=system \
       -Dvulkan-drivers=panfrost \
       -Dpanfrost-kmds=kbase,panthor \
    && ninja -C build-android

# =========================================================================
# STAGE 2: Extracción final del driver unificado monolítico
# =========================================================================
FROM ubuntu:24.04 AS final
WORKDIR /dist
COPY --from=builder /root/mesa/build-android/src/panfrost/vulkan/libvulkan_panfrost.so ./libvulkan_panfrost.so
