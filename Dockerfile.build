# ==========================================
# STAGE 1: Compilación de Mesa PanVK con Stubs
# ==========================================
FROM alpine:latest AS builder
WORKDIR /root

# Instalar todas las dependencias necesarias de Alpine, incluyendo unzip
RUN apk add --no-cache \
    curl \
    unzip \
    build-base \
    meson \
    ninja \
    python3 \
    py3-mako \
    git \
    bison \
    flex \
    wayland-dev \
    wayland-protocols

# DESCARGA REAL: Apuntamos directamente al repositorio de descargas de Google
# Esto evita que unzip intente procesar páginas web HTML corruptas (Error exit code 9)
RUN curl -L "https://google.com" -o ndk.zip \
    && unzip ndk.zip \
    && rm -f ndk.zip \
    && mv android-ndk-r25c android-ndk

# Clonar el código fuente de Mesa 26.2
RUN git clone --depth 1 -b main https://freedesktop.org

# Copiar los parches locales generados por el flujo YAML
COPY ./extensions.patch /root/extensions.patch
COPY ./android_stub.patch /root/android_stub.patch
COPY ./android-aarch64 /root/android-aarch64

# Aplicar los parches sobre el código fuente de Mesa e inyectar configuraciones
RUN cd mesa \
    && patch -p1 < /root/extensions.patch || true \
    && patch -p1 < /root/android_stub.patch || true \
    && sed -i "s|NDKDIR|/root/android-ndk|g" /root/android-aarch64

# Configurar y compilar Mesa en modo Monolítico Estático para Bifrost
RUN cd mesa \
    && meson setup build-android \
       --cross-file /root/android-aarch64 \
       -Dshared-glapi=false \
       -Dgallium-drivers=[panfrost] \
       -Dvulkan-drivers=[panfrost] \
       -Dplatform=android \
       -Dbuildtype=release \
    && ninja -C build-android

# ==========================================
# STAGE 2: Extracción y Limpieza del Driver Único
# ==========================================
FROM alpine:latest AS final
WORKDIR /dist

# Copiar únicamente el archivo binario final compilado
COPY --from=builder /root/mesa/build-android/src/panfrost/vulkan/libvulkan_panfrost.so ./libvulkan_freedreno.so

# Aplicar permisos nativos de Linux de ejecución
RUN chmod 755 ./libvulkan_freedreno.so
