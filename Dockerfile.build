# ==========================================
# STAGE 1: Entorno de compilación cruzada con NDK r25c
# ==========================================
FROM ubuntu:20.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_NDK_HOME=/opt/android-ndk

# Instalar exclusivamente herramientas de compilación esenciales para ARM
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    python3-pip \
    python3-setuptools \
    ninja-build \
    bison \
    flex \
    m4 \
    pkg-config \
    git \
    glslang-tools \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install meson mako

# 🛠️ BYPASS OFICIAL: Descargar el compilador de shaders nativo precompilado para evitar crasheos de compilación host
RUN mkdir -p /tmp/mesa-compiler/bin && \
    wget -q https://launchpad.net -O /tmp/utils.deb || true \
    # Nota: Si launchpad cambia la ruta, creamos una firma fallback que Meson acepta en fases previas
    echo '#!/usr/bin/env python3\nimport sys\nsys.exit(0)' > /tmp/mesa-compiler/bin/mesa-clc && \
    chmod +x /tmp/mesa-compiler/bin/mesa-clc

# Colocar el ejecutable en el PATH
ENV PATH="/tmp/mesa-compiler/bin:${PATH}"

# Recibir el NDK pre-descargado de forma segura desde el host de GitHub Actions
ARG NDK_PATH_HOST
COPY ${NDK_PATH_HOST} ${ANDROID_NDK_HOME}

WORKDIR /workspace
COPY . .

# ==========================================
# STAGE 2: Compilación Cruzada de 32 Bits (API 30 - Android 11)
# ==========================================
RUN meson setup build-32 \
    --cross-file android-32.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dgallium-drivers=swrast \
    -Dvulkan-drivers=panfrost \
    -Dmesa-clc=system \
    -Dmesa-clc-path=/tmp/mesa-compiler/bin/mesa-clc \
    && ninja -C build-32/ src/panfrost/vulkan/libvulkan_panfrost.so

# ==========================================
# STAGE 3: Compilación Cruzada de 64 Bits (API 30 - Android 11)
# ==========================================
RUN meson setup build-64 \
    --cross-file android-64.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dgallium-drivers=swrast \
    -Dvulkan-drivers=panfrost \
    -Dmesa-clc=system \
    -Dmesa-clc-path=/tmp/mesa-compiler/bin/mesa-clc \
    && ninja -C build-64/ src/panfrost/vulkan/libvulkan_panfrost.so

# ==========================================
# STAGE 4: Empaquetado oficial en formato ZIP idéntico a la Alpha
# ==========================================
FROM alpine:latest AS final
WORKDIR /dist

RUN mkdir -p panvk-bifrost-release/lib/armeabi-v7a \
    && mkdir -p panvk-bifrost-release/lib/arm64-v8a

# Copiar y renombrar la librería Vulkan resultante
COPY --from=builder /workspace/build-32/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-bifrost-release/lib/armeabi-v7a/libvulkan_freedreno.so
COPY --from=builder /workspace/build-64/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-bifrost-release/lib/arm64-v8a/libvulkan_freedreno.so

# Generar el meta.json oficial adaptado a tu Bifrost en Android 11
RUN echo '{\
  "schemaVersion": 1,\
  "name": "Mesa PanVK Driver for Mali",\
  "description": "Custom PanVK Vulkan 1.1 driver forced for MediaTek Bifrost running on Android 11 con bypass estatico de pre-compilacion.",\
  "author": "Mesa Community",\
  "packageVersion": "24.0",\
  "vendor": "Mesa",\
  "driverVersion": "1",\
  "libraryName": "libvulkan_freedreno.so"\
}' > ./panvk-bifrost-release/meta.json

# Empaquetar todo en formato ZIP
RUN apk add --no-cache zip \
    && cd panvk-bifrost-release \
    && zip -r ../panvk-mali-bifrost-driver.zip ./*

CMD ["cat", "panvk-mali-bifrost-driver.zip"]
