# ==========================================
# STAGE 1: Entorno base con LLVM nativo para compilar mesa-clc
# ==========================================
FROM ubuntu:20.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_NDK_HOME=/opt/android-ndk

# Instalar herramientas esenciales y dependencias de LLVM exigidas por Mesa
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    python3-pip \
    python3-setuptools \
    ninja-build \
    bison \
    flex \
    m4 \
    pkg-config \
    git \
    glslang-tools \
    llvm-dev \
    libclang-dev \
    clang \
    libelf-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install meson mako

# Recibir el NDK pre-descargado de forma segura desde el host de GitHub Actions
ARG NDK_PATH_HOST
COPY ${NDK_PATH_HOST} ${ANDROID_NDK_HOME}

WORKDIR /workspace
COPY . .

# ==========================================
# STAGE 2: Compilación e Instalación del Compilador Host Real
# ==========================================
RUN meson setup build-compiler \
    -Dprefix=/tmp/mesa-compiler \
    -Dbuildtype=release \
    -Dplatforms= \
    -Dgallium-drivers= \
    -Dvulkan-drivers= \
    -Dmesa-clc=enabled \
    && ninja -C build-compiler src/compiler/vulkan/tools/mesa-clc \
    && mkdir -p /tmp/mesa-compiler/bin \
    && cp build-compiler/src/compiler/vulkan/tools/mesa-clc /tmp/mesa-compiler/bin/

# Colocar el compilador real generado en el PATH del sistema
ENV PATH="/tmp/mesa-compiler/bin:${PATH}"

# ==========================================
# STAGE 3: Compilación Cruzada de 32 Bits (API 30 - Android 11)
# ==========================================
RUN meson setup build-32 \
    --cross-file android-32.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dgallium-drivers=swrast \
    -Dvulkan-drivers=panfrost \
    -Dmesa-clc=system \
    && ninja -C build-32/ src/panfrost/vulkan/libvulkan_panfrost.so

# ==========================================
# STAGE 4: Compilación Cruzada de 64 Bits (API 30 - Android 11)
# ==========================================
RUN meson setup build-64 \
    --cross-file android-64.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dgallium-drivers=swrast \
    -Dvulkan-drivers=panfrost \
    -Dmesa-clc=system \
    && ninja -C build-64/ src/panfrost/vulkan/libvulkan_panfrost.so

# ==========================================
# STAGE 5: Empaquetado oficial en formato ZIP idéntico a la Alpha
# ==========================================
FROM alpine:latest AS final
WORKDIR /dist

RUN mkdir -p panvk-bifrost-release/lib/armeabi-v7a \
    && mkdir -p panvk-bifrost-release/lib/arm64-v8a

# Copiar y renombrar la librería Vulkan resultante
COPY --from=builder /workspace/build-32/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-bifrost-release/lib/armeabi-v7a/libvulkan_freedreno.so
COPY --from=builder /workspace/build-64/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-bifrost-release/lib/arm64-v8a/libvulkan_freedreno.so

# Generar el meta.json oficial
RUN echo '{\
  "schemaVersion": 1,\
  "name": "Mesa PanVK Driver for Mali",\
  "description": "Custom PanVK Vulkan 1.1 driver forced for MediaTek Bifrost running on Android 11 con compilador real LLVM host-clc.",\
  "author": "Mesa Community",\
  "packageVersion": "24.0",\
  "vendor": "Mesa",\
  "driverVersion": "1",\
  "libraryName": "libvulkan_freedreno.so"\
}' > ./panvk-bifrost-release/meta.json

# Empaquetar en ZIP
RUN apk add --no-cache zip \
    && cd panvk-bifrost-release \
    && zip -r ../panvk-mali-bifrost-driver.zip ./*

CMD ["cat", "panvk-mali-bifrost-driver.zip"]
