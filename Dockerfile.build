# ==========================================
# STAGE UNIFICADO: Generación de Driver Real
# ==========================================
FROM alpine:latest AS final
WORKDIR /dist

# Instalar zip para el empaquetado plano nativo
RUN apk add --no-cache zip

# Copiamos las librerías reales ya inyectadas por el pipeline de GitHub
COPY ./libvulkan_freedreno.so ./libvulkan_freedreno.so
COPY ./libGL.so.1 ./libGL.so.1
COPY ./libglapi.so.0 ./libglapi.so.0
COPY ./meta.json ./meta.json

# Cambiar permisos nativos estrictos de Android (CHMOD 755)
RUN chmod 755 ./libGL.so.1 ./libglapi.so.0 ./libvulkan_freedreno.so ./meta.json

# COMPRESIÓN EN RAÍZ: Empaquetamos planos los 4 componentes sueltos
RUN zip -j ../panvk-mali-bifrost-driver.zip ./libGL.so.1 ./libglapi.so.0 ./libvulkan_freedreno.so ./meta.json
RUN mv ../panvk-mali-bifrost-driver.zip ./panvk-mali-bifrost-driver.zip

CMD ["cat", "panvk-mali-bifrost-driver.zip"]
