# ==========================================
# STAGE 1: Entorno de compilación base
# ==========================================
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_NDK_HOME=/opt/android-ndk

# Instalar herramientas necesarias para compilar Mesa
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    python3-pip \
    python3-setuptools \
    ninja-build \
    bison \
    flex \
    m4 \
    pkg-config \
    unzip \
    git \
    glslang-tools \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install meson

# Descarga nativa y limpia del Android NDK r26b para romper la caché
ADD https://google.com /tmp/ndk.zip

RUN mkdir -p /opt \
    && unzip -q /tmp/ndk.zip -d /opt \
    && mv /opt/android-ndk-r26b ${ANDROID_NDK_HOME} \
    && rm /tmp/ndk.zip

# Definir directorio de trabajo y copiar el código local de tu repositorio fork
WORKDIR /workspace
COPY . .

# ==========================================
# STAGE 2: Compilación de 32 Bits (armeabi-v7a)
# ==========================================
FROM builder AS build-32
RUN meson setup build-32 \
    --cross-file android-32.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dgallium-drivers=swrast \
    -Dvulkan-drivers=panfrost \
    && ninja -C build-32/

# ==========================================
# STAGE 3: Compilación de 64 Bits (arm64-v8a)
# ==========================================
FROM builder AS build-64
RUN meson setup build-64 \
    --cross-file android-64.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dgallium-drivers=swrast \
    -Dvulkan-drivers=panfrost \
    && ninja -C build-64/

# ==========================================
# STAGE 4: Empaquetado ICD Driver para Bannerlator
# ==========================================
FROM alpine:latest AS final
WORKDIR /dist

# Estructurar carpetas para el Wrapper Version Manager de Bannerlator
RUN mkdir -p panvk-bifrost-package/lib/armeabi-v7a \
    && mkdir -p panvk-bifrost-package/lib/arm64-v8a

# Copiar binarios de PanVK generados renombrándolos al estándar cargable
COPY --from=build-32 /workspace/build-32/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-bifrost-package/lib/armeabi-v7a/libvulkan_wrapper.so
COPY --from=build-64 /workspace/build-64/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-bifrost-package/lib/arm64-v8a/libvulkan_wrapper.so

# Crear el manifiesto wrappers.json configurado para forzar compatibilidad Bifrost
RUN echo '[{\
  "id": "panvk-bifrost-stubs",\
  "name": "PanVK Mali Bifrost + Stubs (Experimental)",\
  "description": "Driver Vulkan PanVK forzado para arquitectura Bifrost (G31/G52/G72/G76) con stubs Android integrados para evadir restricciones de ruta /dev/dri.",\
  "author": "Over-cmd",\
  "version": "26.2.0-bifrost",\
  "gpuTargets": ["mali"],\
  "features": ["panvk_android_stubs", "vulkan_1_1"],\
  "type": "icd_wrapper"\
}]' > ./panvk-bifrost-package/wrappers.json

# Compresión nativa directa (.tar.xz)
RUN cd panvk-bifrost-package && tar -cJf ../panvk-bifrost-stubs-bannerlator.tar.xz lib/ wrappers.json

CMD ["cat", "panvk-bifrost-stubs-bannerlator.tar.xz"]
