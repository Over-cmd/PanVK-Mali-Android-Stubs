# =========================================================================
# STAGE 1: Entorno de Compilación Cruzada (Android NDK + Meson + funnymdzz)
# =========================================================================
FROM alpine:latest AS builder
WORKDIR /root

# Instalar todas las dependencias necesarias de Alpine, incluyendo unzip y pkgconfig
RUN apk add --no-cache \
    curl \
    unzip \
    build-base \
    meson \
    ninja \
    python3 \
    py3-mako \
    git \
    bison \
    flex \
    wayland-dev \
    wayland-protocols \
    pkgconfig

# Descargar e instalar el Android NDK r25c oficial de forma legítima para la API 26
RUN curl -L "https://google.com" -o ndk.zip \
    && unzip ndk.zip \
    && rm -f ndk.zip \
    && mv android-ndk-r25c android-ndk

# CLONACIÓN DEL REPOSITORIO DE FUNNYMDZZ (Soporte real para Mali kbase)
RUN git clone --depth 1 https://github.com /root/mesa

# Copiar los parches locales generados por el flujo YAML
COPY ./extensions.patch /root/extensions.patch
COPY ./android_stub.patch /root/android_stub.patch
COPY ./android-aarch64 /root/android-aarch64

# Aplicar los parches sobre el árbol de código fuente de funnymdzz e inyectar el NDK
RUN cd /root/mesa \
    && patch -p1 < /root/extensions.patch || true \
    && patch -p1 < /root/android_stub.patch || true \
    && sed -i "s|NDKDIR|/root/android-ndk|g" /root/android-aarch64

# Configurar y compilar Mesa en modo Monolítico Estático para Bifrost (Mali-G52)
# Desactivamos shared-glapi para que todo el núcleo de vídeo se fusione en el archivo final
RUN cd /root/mesa \
    && meson setup build-android \
       --cross-file /root/android-aarch64 \
       -Dshared-glapi=false \
       -Dgallium-drivers=[panfrost] \
       -Dvulkan-drivers=[panfrost] \
       -Dplatform=android \
       -Dbuildtype=release \
       -Dandroid-stub=true \
    && ninja -C build-android

# =========================================================================
# STAGE 2: Extracción y Renombrado Estricto para Bannerlator
# =========================================================================
FROM alpine:latest AS final
WORKDIR /dist

# Traemos el binario legítimo compilado de funnymdzz y lo enmascaramos con el nombre
# que busca el Linker de tu APK para engañar al instalador móvil
COPY --from=builder /root/mesa/build-android/src/panfrost/vulkan/libvulkan_panfrost.so ./libvulkan_freedreno.so
