# ==========================================
# STAGE 1: Entorno de configuración unificado con NDK
# ==========================================
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_NDK_HOME=/opt/android-ndk

# Instalar herramientas críticas para Mesa 26.2+
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    python3-pip \
    python3-setuptools \
    ninja-build \
    bison \
    flex \
    m4 \
    pkg-config \
    git \
    glslang-tools \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install meson mako

# Recibir el NDK pre-descargado de forma nativa desde GitHub Actions
ARG NDK_PATH_HOST
COPY ${NDK_PATH_HOST} ${ANDROID_NDK_HOME}

WORKDIR /workspace
COPY . .

# 🛠️ MOCK INTELIGENTE: Emula las respuestas requeridas por el validador de Mesa 26.2-rc1
RUN mkdir -p /tmp/mock-bin && \
    echo '#!/usr/bin/env python3\n\
import sys\n\
if "--version" in sys.argv:\n\
    print("26.2.0")\n\
sys.exit(0)' > /tmp/mock-bin/mesa-clc && \
    chmod +x /tmp/mock-bin/mesa-clc

# ==========================================
# STAGE 2: Compilación Cruzada de 32 Bits (armeabi-v7a)
# ==========================================
RUN meson setup build-32 \
    --cross-file android-32.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dandroid-stub=true \
    -Dgallium-drivers=swrast \
    -Dvulkan-drivers=panfrost \
    -Dmesa-clc=system \
    -Dmesa-clc-path=/tmp/mock-bin/mesa-clc \
    && ninja -C build-32/ src/panfrost/vulkan/libvulkan_panfrost.so

# ==========================================
# STAGE 3: Compilación Cruzada de 64 Bits (arm64-v8a)
# ==========================================
RUN meson setup build-64 \
    --cross-file android-64.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dandroid-stub=true \
    -Dgallium-drivers=swrast \
    -Dvulkan-drivers=panfrost \
    -Dmesa-clc=system \
    -Dmesa-clc-path=/tmp/mock-bin/mesa-clc \
    && ninja -C build-64/ src/panfrost/vulkan/libvulkan_panfrost.so

# ==========================================
# STAGE 4: Empaquetado Estructurado ICD para Bannerlator
# ==========================================
FROM alpine:latest AS final
WORKDIR /dist

# Crear la jerarquía oficial que lee el Wrapper Version Manager de Bannerlator
RUN mkdir -p panvk-bifrost-package/lib/armeabi-v7a \
    && mkdir -p panvk-bifrost-package/lib/arm64-v8a

# Copiar las librerías binarias nativas mapeadas al estándar cargable de la app
COPY --from=builder /workspace/build-32/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-bifrost-package/lib/armeabi-v7a/libvulkan_wrapper.so
COPY --from=builder /workspace/build-64/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-bifrost-package/lib/arm64-v8a/libvulkan_wrapper.so

# Escribir el archivo manifiesto wrappers.json
RUN echo '[{\
  "id": "panvk-bifrost-stubs",\
  "name": "PanVK Mali Bifrost + Stubs (Experimental)",\
  "description": "Driver Vulkan PanVK forzado para arquitectura Bifrost (G31/G52/G72/G76) con stubs Android de la Alpha v1.0 e inyeccion inteligente de python-clc bypass.",\
  "author": "Over-cmd",\
  "version": "26.2.0-bifrost",\
  "gpuTargets": ["mali"],\
  "features": ["panvk_android_stubs", "vulkan_1_1"],\
  "type": "icd_wrapper"\
}]' > ./panvk-bifrost-package/wrappers.json

# Compresión nativa directa (.tar.xz)
RUN cd panvk-bifrost-package && tar -cJf ../panvk-bifrost-stubs-bannerlator.tar.xz lib/ wrappers.json

CMD ["cat", "panvk-bifrost-stubs-bannerlator.tar.xz"]
