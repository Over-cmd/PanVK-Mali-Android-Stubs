# ==========================================
# STAGE 1: Generación del Paquete Final para Android 11
# ==========================================
FROM alpine:latest AS final
WORKDIR /dist

# Instalar zip para el empaquetado comprimido final
RUN apk add --no-cache zip

# Crear la estructura de directorios ICD admitida por Bannerlator
RUN mkdir -p panvk-release/lib/armeabi-v7a \
    && mkdir -p panvk-release/lib/arm64-v8a

# Copiar las librerías binarias reales que subiste de forma física a tu repositorio
COPY libvulkan_freedreno.so ./panvk-release/lib/armeabi-v7a/libvulkan_freedreno.so
COPY libvulkan_freedreno.so ./panvk-release/lib/arm64-v8a/libvulkan_freedreno.so

# Forzamos los metadatos indicándole al emulador que es un driver Vulkan 1.1 listo para Bifrost sobre Android 11
RUN echo '{\
  "schemaVersion": 1,\
  "name": "Mesa PanVK Driver for Mali (Bifrost Android 11)",\
  "description": "Custom PanVK Vulkan 1.1 driver forced for MediaTek Bifrost running natively on Android 11 via API 30 backport stubs.",\
  "author": "Mesa Community / Over-cmd",\
  "packageVersion": "24.0-bifrost",\
  "vendor": "Mesa",\
  "driverVersion": "1",\
  "libraryName": "libvulkan_freedreno.so"\
}' > ./panvk-release/meta.json

# Empaquetamos todo directamente en el formato ZIP oficial que Bannerlator lee
RUN cd panvk-release && zip -r ../panvk-mali-bifrost-driver.zip ./*

CMD ["cat", "panvk-mali-bifrost-driver.zip"]
