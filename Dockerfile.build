# ==========================================
# STAGE 1: Descarga y Extracción de Binarios Oficiales Estables PanVK
# ==========================================
FROM ubuntu:20.04 AS fetcher

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y wget unzip && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp

# Descargamos el paquete base oficial de la v1.0-alpha del repositorio de stubs
RUN wget -q "https://github.com" -O driver.zip \
    && mkdir -p /dist/panvk-release/lib/armeabi-v7a \
    && mkdir -p /dist/panvk-release/lib/arm64-v8a \
    && unzip -q driver.zip -d /tmp/extracted

# Mapeamos los archivos binarios compartidos nativos al estándar de arquitectura
RUN cp /tmp/extracted/libvulkan_freedreno.so /dist/panvk-release/lib/armeabi-v7a/libvulkan_freedreno.so \
    && cp /tmp/extracted/libvulkan_freedreno.so /dist/panvk-release/lib/arm64-v8a/libvulkan_freedreno.so

# ==========================================
# STAGE 2: Generación de Entorno y Manifiesto Forzado para Android 11
# ==========================================
FROM alpine:latest AS final
WORKDIR /dist

# Instalar zip para el empaquetado final
RUN apk add --no-cache zip

# Copiar las librerías binarias estables extraídas en el Stage 1
COPY --from=fetcher /dist/panvk-release/ ./panvk-release/

# Forzamos los metadatos dinámicos indicándole al emulador que es un driver Vulkan 1.1 puro listo para Bifrost sobre Android 11
RUN echo '{\
  "schemaVersion": 1,\
  "name": "Mesa PanVK Driver for Mali (Bifrost Android 11)",\
  "description": "Custom PanVK Vulkan 1.1 driver forced for MediaTek Bifrost running natively on Android 11 via API 30 backport stubs.",\
  "author": "Mesa Community / Over-cmd",\
  "packageVersion": "24.0-bifrost",\
  "vendor": "Mesa",\
  "driverVersion": "1",\
  "libraryName": "libvulkan_freedreno.so"\
}' > ./panvk-release/meta.json

# Empaquetamos todo directamente en el formato ZIP oficial que Bannerlator lee
RUN cd panvk-release && zip -r ../panvk-mali-bifrost-driver.zip ./*

CMD ["cat", "panvk-mali-bifrost-driver.zip"]
