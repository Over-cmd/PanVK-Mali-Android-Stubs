# =========================================================================
# STAGE 1: Entorno de Compilación Cruzada con funnymdzz (Mali kbase)
# =========================================================================
FROM ubuntu:24.04 AS builder
WORKDIR /root

# Evitar diálogos interactivos durante la instalación de paquetes
ENV DEBIAN_FRONTEND=noninteractive

# Instalar dependencias esenciales y el ecosistema de Rust necesario para KRAID/PanVK
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    meson \
    ninja-build \
    python3 \
    python3-pip \
    python3-mako \
    git \
    bison \
    flex \
    pkg-config \
    libdrm-dev \
    libxshmfence-dev \
    glslang-tools \
    rustc \
    cargo \
    cbindgen \
    && rm -rf /var/lib/apt/lists/*

# Forzar el enlace simbólico de glslang para que Meson lo localice sin problemas
RUN ln -s /usr/bin/glslangValidator /usr/bin/glslang_validator || true

# Recibimos las fuentes de Mesa, el Android NDK y los archivos locales desde el flujo YAML
COPY ./mesa /root/mesa
COPY ./android-ndk /root/android-ndk
COPY ./extensions.patch /root/extensions.patch
COPY ./android_stub.patch /root/android_stub.patch
COPY ./android-aarch64 /root/android-aarch64

# Aplicar los parches locales e inyectar la ruta física del NDK en el cross-file
RUN cd /root/mesa \
    && patch -p1 < /root/extensions.patch || true \
    && patch -p1 < /root/android_stub.patch || true \
    && sed -i "s|NDKDIR|/root/android-ndk|g" /root/android-aarch64

# CONFIGURACIÓN COMPARTIDA: Activamos shared-glapi y enlazamos panfrost con panvk
RUN cd /root/mesa \
    && meson setup build-android \
       --cross-file /root/android-aarch64 \
       -Dshared-glapi=true \
       -Dgallium-drivers=panfrost \
       -Dvulkan-drivers=panvk \
       -Dplatform=android \
       -Dglx=disabled \
       -Degl=disabled \
       -Dgbm=disabled \
       -Dgles1=disabled \
       -Dgles2=disabled \
       -Dbuildtype=release \
    && ninja -C build-android

# =========================================================================
# STAGE 2: Conservación de los Archivos Compartidos para la Extracción
# =========================================================================
FROM ubuntu:24.04 AS final
WORKDIR /dist

# Copiamos tanto el driver Vulkan de Mali como la API compartida generada por Meson
COPY --from=builder /root/mesa/build-android/src/panfrost/vulkan/libvulkan_panfrost.so ./libvulkan_panfrost.so
COPY --from=builder /root/mesa/build-android/src/mapi/shared-glapi/libglapi.so ./libglapi.so
