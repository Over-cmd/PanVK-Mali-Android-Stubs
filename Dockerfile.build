# ==========================================
# STAGE 1: Entorno de configuración base con NDK r25c
# ==========================================
FROM ubuntu:20.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_NDK_HOME=/opt/android-ndk

# Instalar herramientas de compilación compatibles con la rama Mesa 24
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    python3-pip \
    python3-setuptools \
    ninja-build \
    bison \
    flex \
    m4 \
    pkg-config \
    git \
    glslang-tools \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install meson mako

# Descargar e instalar el Android NDK r25c (El más estable y compatible para Android 11)
ADD https://google.com /tmp/ndk.zip
RUN mkdir -p /opt \
    && unzip -q /tmp/ndk.zip -d /opt \
    && mv /opt/android-ndk-r25c ${ANDROID_NDK_HOME} \
    && rm /tmp/ndk.zip

WORKDIR /workspace

# Clonar la rama de Mesa con soporte Vulkan 1.1 maduro para Bifrost
RUN git clone --depth 1 --branch mesa-24.0.0 https://freedesktop.org .

# Copiar tus stubs locales de compatibilidad Android hacia el árbol de fuentes
COPY . .

# ==========================================
# STAGE 2: Compilación Cruzada de 32 Bits (API 30 - Android 11)
# ==========================================
RUN meson setup build-32 \
    --cross-file android-32.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dgallium-drivers=swrast \
    -Dvulkan-drivers=panfrost \
    && ninja -C build-32/ src/panfrost/vulkan/libvulkan_panfrost.so

# ==========================================
# STAGE 3: Compilación Cruzada de 64 Bits (API 30 - Android 11)
# ==========================================
RUN meson setup build-64 \
    --cross-file android-64.toml \
    --buildtype=release \
    -Dplatforms=android \
    -Dgallium-drivers=swrast \
    -Dvulkan-drivers=panfrost \
    -Dmesa-clc=disabled \
    && ninja -C build-64/ src/panfrost/vulkan/libvulkan_panfrost.so

# ==========================================
# STAGE 4: Empaquetado en formato ZIP con el Manifiesto de la Alpha
# ==========================================
FROM alpine:latest AS final
WORKDIR /dist

RUN mkdir -p panvk-bifrost-release/lib/armeabi-v7a \
    && mkdir -p panvk-bifrost-release/lib/arm64-v8a

# Copiar y renombrar la librería Vulkan al estándar cargable de la release alpha
COPY --from=builder /workspace/build-32/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-bifrost-release/lib/armeabi-v7a/libvulkan_freedreno.so
COPY --from=builder /workspace/build-64/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-bifrost-release/lib/arm64-v8a/libvulkan_freedreno.so

# Generar el meta.json mapeado al nombre de archivo inyectado
RUN echo '{\
  "schemaVersion": 1,\
  "name": "Mesa PanVK Driver for Mali",\
  "description": "Custom PanVK Vulkan 1.1 driver forced for MediaTek Bifrost running on Android 11.",\
  "author": "Mesa Community",\
  "packageVersion": "24.0",\
  "vendor": "Mesa",\
  "driverVersion": "1",\
  "libraryName": "libvulkan_freedreno.so"\
}' > ./panvk-bifrost-release/meta.json

# Empaquetar el driver en un archivo comprimido .zip listo para el celular
RUN apk add --no-cache zip \
    && cd panvk-bifrost-release \
    && zip -r ../panvk-bifrost-android11.zip ./*

CMD ["cat", "panvk-bifrost-android11.zip"]
