FROM ubuntu:20.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_NDK_HOME=/opt/android-ndk

RUN apt-get update && apt-get install -y \
    build-essential python3 python3-pip python3-setuptools \
    ninja-build bison flex m4 pkg-config git glslang-tools && rm -rf /var/lib/apt/lists/*
RUN pip3 install meson mako

ARG NDK_PATH_HOST
COPY ${NDK_PATH_HOST} ${ANDROID_NDK_HOME}

WORKDIR /workspace
COPY . .

RUN meson setup build-32 --cross-file android-32.toml --buildtype=release -Dplatforms=android -Dgallium-drivers=swrast -Dvulkan-drivers=panfrost && ninja -C build-32/ src/panfrost/vulkan/libvulkan_panfrost.so
RUN meson setup build-64 --cross-file android-64.toml --buildtype=release -Dplatforms=android -Dgallium-drivers=swrast -Dvulkan-drivers=panfrost && ninja -C build-64/ src/panfrost/vulkan/libvulkan_panfrost.so

FROM alpine:latest AS final
WORKDIR /dist
RUN mkdir -p panvk-bifrost-release/lib/armeabi-v7a panvk-bifrost-release/lib/arm64-v8a
COPY --from=builder /workspace/build-32/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-bifrost-release/lib/armeabi-v7a/libvulkan_freedreno.so
COPY --from=builder /workspace/build-64/src/panfrost/vulkan/libvulkan_panfrost.so ./panvk-bifrost-release/lib/arm64-v8a/libvulkan_freedreno.so

RUN echo '{"schemaVersion":1,"name":"Mesa PanVK Driver for Mali","description":"Custom PanVK Vulkan 1.1 driver forced for MediaTek Bifrost running on Android 11.","author":"Mesa Community","packageVersion":"24.0","vendor":"Mesa","driverVersion":"1","libraryName":"libvulkan_freedreno.so"}' > ./panvk-bifrost-release/meta.json
RUN apk add --no-cache zip && cd panvk-bifrost-release && zip -r ../panvk-mali-bifrost-driver.zip ./*
CMD ["cat", "panvk-mali-bifrost-driver.zip"]
