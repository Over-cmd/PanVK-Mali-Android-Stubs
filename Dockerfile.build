# ==========================================
# STAGE 1: Generación del Paquete Oficial de Adrenotools en la Raíz
# ==========================================
FROM alpine:latest AS final
WORKDIR /dist

# Instalar zip para el empaquetado final
RUN apk add --no-cache zip

# Crear directorio de ordenamiento plano temporal
RUN mkdir -p root-package

# Copiamos los tres archivos binarios legítimos sueltos en la raíz del paquete
COPY panvk-release/libvulkan_freedreno.so ./root-package/libvulkan_freedreno.so
COPY panvk-release/libGL.so.1 ./root-package/libGL.so.1
COPY panvk-release/libglapi.so.0 ./root-package/libglapi.so.0

# Escribimos el manifiesto meta.json con la firma oficial que Adrenotools exige
RUN echo '{\
  "schemaVersion": 1,\
  "name": "Mesa PanVK Driver for Mali",\
  "description": "Custom PanVK Vulkan driver for MediaTek",\
  "author": "Mesa Community",\
  "packageVersion": "26.2",\
  "vendor": "Mesa",\
  "driverVersion": "1",\
  "libraryName": "libvulkan_freedreno.so"\
}' > ./root-package/meta.json

# Duplicamos la firma como manifest.json por si tu versión de Adrenotools busca ese nombre alternativo
RUN cp ./root-package/meta.json ./root-package/manifest.json

# COMPRESIÓN EN RAÍZ: Entramos a la carpeta y comprimimos exclusivamente los archivos sueltos
# Esto garantiza que al abrir el ZIP aparezcan de inmediato libGL.so.1, libglapi.so.0, libvulkan_freedreno.so y meta.json
RUN cd root-package && zip -r ../panvk-mali-bifrost-driver.zip ./libGL.so.1 ./libglapi.so.0 ./libvulkan_freedreno.so ./meta.json ./manifest.json

CMD ["cat", "panvk-mali-bifrost-driver.zip"]
