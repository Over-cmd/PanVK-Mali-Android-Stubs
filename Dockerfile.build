# =========================================================================
# STAGE 1: Entorno de Compilación Cruzada con funnymdzz (Mali kbase)
# =========================================================================
FROM alpine:latest AS builder
WORKDIR /root

# Instalar dependencias nativas esenciales de Alpine (incluyendo libdrm-dev)
RUN apk add --no-cache \
    curl \
    build-base \
    meson \
    ninja \
    python3 \
    py3-mako \
    git \
    bison \
    flex \
    wayland-dev \
    wayland-protocols \
    pkgconfig \
    libdrm-dev

# Recibimos las fuentes de Mesa, el Android NDK y los archivos locales desde el flujo YAML
COPY ./mesa /root/mesa
COPY ./android-ndk /root/android-ndk
COPY ./extensions.patch /root/extensions.patch
COPY ./android_stub.patch /root/android_stub.patch
COPY ./android-aarch64 /root/android-aarch64

# Aplicar los parches e inyectar la ruta física del compilador en el archivo cruzado
RUN cd /root/mesa \
    && patch -p1 < /root/extensions.patch || true \
    && patch -p1 < /root/android_stub.patch || true \
    && sed -i "s|NDKDIR|/root/android-ndk|g" /root/android-aarch64

# CONFIGURACIÓN CORREGIDA: Ajustamos las banderas al estándar estricto de Mesa 26
# Cambiamos platforms a -Dplatform=android y ajustamos los arrays de compilación
RUN cd /root/mesa \
    && meson setup build-android \
       --cross-file /root/android-aarch64 \
       -Dshared-glapi=false \
       -Dgallium-drivers=panfrost \
       -Dvulkan-drivers=panfrost \
       -Dplatform=android \
       -Dbuildtype=release \
    && ninja -C build-android

# =========================================================================
# STAGE 2: Extracción y Limpieza del Driver Final de Mali
# =========================================================================
FROM alpine:latest AS final
WORKDIR /dist

# Extraemos el binario legítimo compilado de Mali de funnymdzz mapeándolo al nombre freedreno
COPY --from=builder /root/mesa/build-android/src/panfrost/vulkan/libvulkan_panfrost.so ./libvulkan_freedreno.so
